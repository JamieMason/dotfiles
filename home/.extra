#!/usr/bin/env bash

# homebrew (Apple Silicon: /opt/homebrew, Intel: /usr/local)
if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi

GITHUB_HANDLE="JamieMason"
USER_NAME="Jamie Mason"
USER_EMAIL="jamie@foldleft.io"
USER_URL="https://github.com/JamieMason"

# git
GIT_AUTHOR_NAME="$USER_NAME"
GIT_COMMITTER_NAME="$USER_NAME"
git config --global user.name "$USER_NAME"
GIT_AUTHOR_EMAIL="$USER_EMAIL"
GIT_COMMITTER_EMAIL="$USER_EMAIL"
git config --global user.email "$USER_EMAIL"
git config --global core.editor "nvim"

# fnm
eval "$(fnm env --use-on-cd)"

# rust
source $HOME/.cargo/env

# postgres
export PATH="$(brew --prefix)/opt/postgresql@17/bin:$PATH"

# For compilers to find postgresql@17 you may need to set:
export LDFLAGS="-L$(brew --prefix)/opt/postgresql@17/lib"
export CPPFLAGS="-I$(brew --prefix)/opt/postgresql@17/include"

# delta (git diffs)
git config --global core.pager delta
git config --global interactive.diffFilter "delta --color-only"
git config --global delta.navigate true
git config --global delta.line-numbers true
git config --global merge.conflictstyle zdiff3
