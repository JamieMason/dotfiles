#!/usr/bin/env bash
#
# gl — interactive git log helper (bash port of src/bin/gl.rs).
#
# Pick commits from the current branch → pick a command → act. The Rust kept a
# hand-written lazy "load more" pager. Here we stream `git log` straight into
# fzf rather than buffering the whole history first: git emits newest-first and
# fzf shows the first screenful at once, reading more only as the list is
# scrolled or searched — so startup no longer walks the entire history.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lib="$here/../lib"
# shellcheck source=/dev/null
for mod in colors platform paths github status files commits log ui git; do source "$lib/$mod.sh"; done

gl::main() {
  git::is_repo || { echo "Error: not a git repository" >&2; exit 1; }
  local current
  current=$(git::current_branch) || { echo "Error: detached HEAD" >&2; exit 1; }

  if ! git rev-parse --verify --quiet HEAD >/dev/null; then
    printf 'git log (%s)\nNo commits found.\n' "$current"
    return 0
  fi

  # Stream commits into fzf; see the file header for why we don't buffer first.
  # Extra CLI args are forwarded to `git log` (e.g. `gl -n 5`, `gl --author=me`,
  # `gl v1.0..HEAD`); with none, git log defaults to HEAD as before.
  local picked
  picked=$(git::commit_rows "$@" | commits::render \
    | ui::pick_many "git log $(colour::blue "($current)")") || true
  [ -z "$picked" ] && return 0
  ui::read_items <<< "$picked"
  local -a sel=("${UI_ITEMS[@]}")

  # Offer "reset --soft" only when the selection is exactly the newest N commits.
  local commands
  commands=$'open files\ndiff\nview commit on github'
  if gl::_is_newest_n "${sel[@]}"; then
    commands+=$'\nreset --soft'
  fi

  local command
  command=$(printf '%s\n' "$commands" | ui::pick_one "Choose command:") || true
  case $command in
    "open files")            gl::open_files "${sel[@]}" ;;
    "diff")                  gl::diff "${sel[@]}" ;;
    "view commit on github") github::open_commits "${sel[@]}" ;;
    "reset --soft")          gl::reset_soft "${#sel[@]}" ;;
  esac
}

# True when the selected hashes are exactly the newest N commits reachable from
# HEAD, with no gaps — the condition the Rust used to enable `reset --soft
# HEAD~n`. Comparing against just the newest N (not the whole history) keeps the
# check cheap now that the list is streamed rather than buffered.
gl::_is_newest_n() {
  local n=$#
  [ "$n" -gt 0 ] || return 1
  local newest selected
  newest=$(git log -n "$n" --format=%h HEAD | sort) || return 1
  selected=$(printf '%s\n' "$@" | sort)
  [ "$newest" = "$selected" ]
}

gl::open_files() {
  files::select_changed "$(git::root)" "$@" || return 0
  log::batch_apply "Opened" "open" "file(s)" platform::open log::echo "${UI_ITEMS[@]}"
}

# Show each selected file as it appears at each selected commit (git show).
gl::diff() {
  local -a commits=("$@")
  files::select_changed "$(git::root)" "$@" || return 0
  local -a paths=("${UI_ITEMS[@]}")
  local c p
  for c in "${commits[@]}"; do
    for p in "${paths[@]}"; do
      git show "$c" -- "$p"
    done
  done
}

gl::reset_soft() {
  local count=$1
  if git reset --soft "HEAD~$count"; then
    printf 'Soft reset %d commits\n' "$count"
  else
    echo "git reset failed" >&2
    return 1
  fi
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  gl::main "$@"
fi
