#!/usr/bin/env bash
#
# gl — interactive git log helper (bash port of src/bin/gl.rs).
#
# Pick commits from the current branch → pick a command → act. The Rust kept a
# hand-written lazy "load more" pager; fzf scrolls the whole list natively, so
# we just hand it every commit.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lib="$here/../lib"
# shellcheck source=/dev/null
for mod in colors platform paths github status files commits log ui git; do source "$lib/$mod.sh"; done

gl::main() {
  git::is_repo || { echo "Error: not a git repository" >&2; exit 1; }
  local current
  current=$(git::current_branch) || { echo "Error: detached HEAD" >&2; exit 1; }

  local rows
  rows=$(git::commit_rows HEAD)
  if [ -z "$rows" ]; then
    printf 'git log (%s)\nNo commits found.\n' "$current"
    return 0
  fi

  local picked
  picked=$(printf '%s\n' "$rows" | commits::render | ui::pick_many "git log $(colour::blue "($current)")") || true
  [ -z "$picked" ] && return 0
  ui::read_items <<< "$picked"
  local -a sel=("${UI_ITEMS[@]}")

  # Offer "reset --soft" only when the selection is exactly the newest N commits.
  local commands
  commands=$'open files\ndiff\nview commit on github'
  if gl::_is_newest_n "$(printf '%s' "$rows" | cut -f2)" "${sel[@]}"; then
    commands+=$'\nreset --soft'
  fi

  local command
  command=$(printf '%s\n' "$commands" | ui::pick_one "Choose command:") || true
  case $command in
    "open files")            gl::open_files "${sel[@]}" ;;
    "diff")                  gl::diff "${sel[@]}" ;;
    "view commit on github") github::open_commits "${sel[@]}" ;;
    "reset --soft")          gl::reset_soft "${#sel[@]}" ;;
  esac
}

# True when the selected hashes occupy positions 0..n-1 of the full ordered
# list (i.e. the most recent commits with no gaps) — the condition the Rust
# used to enable `reset --soft HEAD~n`.
gl::_is_newest_n() {
  local all=$1
  shift
  local -a pos=()
  local s idx
  for s in "$@"; do
    idx=$(printf '%s\n' "$all" | grep -nxF "$s" | head -1 | cut -d: -f1) || return 1
    [ -z "$idx" ] && return 1
    pos+=($((idx - 1)))
  done
  local want=0 p
  while IFS= read -r p; do
    [ "$p" = "$want" ] || return 1
    want=$((want + 1))
  done < <(printf '%s\n' "${pos[@]}" | sort -n)
}

gl::open_files() {
  files::select_changed "$(git::root)" "$@" || return 0
  log::batch_apply "Opened" "open" "file(s)" platform::open log::echo "${UI_ITEMS[@]}"
}

# Show each selected file as it appears at each selected commit (git show).
gl::diff() {
  local -a commits=("$@")
  files::select_changed "$(git::root)" "$@" || return 0
  local -a paths=("${UI_ITEMS[@]}")
  local c p
  for c in "${commits[@]}"; do
    for p in "${paths[@]}"; do
      git show "$c" -- "$p"
    done
  done
}

gl::reset_soft() {
  local count=$1
  if git reset --soft "HEAD~$count"; then
    printf 'Soft reset %d commits\n' "$count"
  else
    echo "git reset failed" >&2
    return 1
  fi
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  gl::main "$@"
fi
